# ---------------------------------------------------------------
# Copier ce fichier en ".env" puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être versionné (voir .gitignore).
# ---------------------------------------------------------------

# Clé secrète Django : générer une valeur unique avec :
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=a-remplacer-par-une-cle-longue-et-aleatoire

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Adresse publique du site, utilisée dans les liens des e-mails (sans « / » final).
SITE_URL=http://127.0.0.1:8000

# Base de données : SQLite par défaut si absent.
# PostgreSQL : DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/repetivoire
# DATABASE_URL=sqlite:///db.sqlite3

# Notifications : interne uniquement par défaut. Une fois le SMTP configuré :
# NOTIFICATION_CHANNELS=notifications.channels.InAppChannel,notifications.channels.EmailChannel

# E-mail : en local, les e-mails sont affichés dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Répét'Ivoire <no-reply@repetivoire.local>

CONTACT_EMAIL=contact@repetivoire.local
CONTACT_PHONE=
# Numéro WhatsApp du bouton flottant (ex. : 0701020304). Vide = bouton masqué.
WHATSAPP_NUMBER=

# Mentions légales (à renseigner avant la mise en ligne)
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_FORM=
LEGAL_RCCM=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
LEGAL_HOST=

# Fonctionnalités (désactivées au lancement)
FEATURE_REVIEWS_ENABLED=False
FEATURE_PAYMENTS_ENABLED=False
